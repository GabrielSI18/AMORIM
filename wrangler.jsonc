{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "amorim",
  "compatibility_date": "2025-09-27",
  // Evita o helper __name do esbuild em scripts inline (quebra o next-themes no browser)
  "keep_names": false,
  "main": ".open-next/worker.js",
  "workers_dev": false,
  "routes": [
    { "pattern": "amorimturismo.com.br", "custom_domain": true },
    { "pattern": "www.amorimturismo.com.br", "custom_domain": true }
  ],
  "unsafe": {
    "bindings": [
      // Rate limit na borda da Cloudflare (vale para todas as instâncias do Worker)
      {
        "name": "CONTACT_LIMITER",
        "type": "ratelimit",
        "namespace_id": "1001",
        "simple": { "limit": 5, "period": 60 }
      },
      {
        "name": "BOOKING_LIMITER",
        "type": "ratelimit",
        "namespace_id": "1002",
        "simple": { "limit": 10, "period": 60 }
      }
    ]
  },
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ]
}
